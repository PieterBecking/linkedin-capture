{
  "manifest_version": 3,
  "name": "LinkedIn → CRM capture",
  "version": "0.2.0",
  "description": "Capture an open LinkedIn message thread into the Servo7 CRM as a meeting note, or export a candidate profile to the recruitment pipeline.",
  "permissions": ["sidePanel", "storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://app.juicebox.ai/*",
    "https://brain.servo7.com/*",
    "https://crm.becking.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/favicon-16.png",
    "32": "icons/favicon-32.png",
    "128": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_title": "Capture LinkedIn thread",
    "default_icon": {
      "16": "icons/favicon-16.png",
      "32": "icons/favicon-32.png",
      "128": "icons/icon-192.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}
